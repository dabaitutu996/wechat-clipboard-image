#!/usr/bin/env node
// wl-paste supplies the copied URI on stdin. Only convert WeChat temporary images.
const fs = require('fs');
const os = require('os');
const path = require('path');
const { fileURLToPath } = require('url');
const { spawnSync } = require('child_process');

let input = '';
process.stdin.setEncoding('utf8');
process.stdin.on('data', chunk => { if (input.length < 16384) input += chunk; });
process.stdin.on('end', () => {
  const lines = input.split(/\r?\n/).filter(line => line && !line.startsWith('#'));
  if (lines.length !== 1) return;
  let filename;
  try { filename = fileURLToPath(lines[0]); } catch { return; }
  const base = path.join(os.homedir(), '文档', 'xwechat_files') + path.sep;
  let real;
  try { real = fs.realpathSync(filename); } catch { return; }
  if (!real.startsWith(base) || !real.includes('/temp/RWTemp/') || !/\.(jpe?g|png|webp|bmp)$/i.test(real)) return;
  const result = spawnSync('ffmpeg', ['-v', 'error', '-i', real, '-frames:v', '1', '-f', 'image2pipe', '-vcodec', 'png', '-'], { maxBuffer: 100 * 1024 * 1024 });
  if (result.status !== 0 || !result.stdout?.length) return;
  const current = spawnSync('wl-paste', ['--type', 'text/uri-list', '--no-newline'], { encoding: 'utf8' });
  if (current.status !== 0 || current.stdout.trim() !== input.trim()) return;
  spawnSync('wl-copy', ['--type', 'image/png'], { input: result.stdout });
});
